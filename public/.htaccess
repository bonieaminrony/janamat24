<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve news-image via seo.php (no bot check needed — always serve image)
  RewriteRule ^news-image/(.*)$ seo.php?type=news-image&slug=$1 [L,QSA]

  # Rewrite sitemap.xml to sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Intercept social media & search engine bots → seo.php for OG meta
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|Pinterest|WhatsApp|LinkedInBot|vkShare|W3C_Validator|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Googlebot|bingbot|Applebot|ia_archiver) [NC]
  RewriteCond %{QUERY_STRING} !spa=1
  RewriteRule ^(news|category)/(.*)$ seo.php?type=$1&slug=$2 [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml font/woff2 font/woff image/svg+xml
</IfModule>

# Enable Browser Caching & Long-term Cache-Control Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresDefault "access plus 2 days"
</IfModule>

<IfModule mod_headers.c>
  # Cache immutable static assets in /assets/ for 1 year
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Ensure index.html always gets revalidated quickly
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

